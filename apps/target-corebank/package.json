{
  "name": "target-corebank",
  "version": "0.0.1",
  "description": "Stand-in legacy back-office banking app: framesets, table layouts, no test IDs, injectable runtime faults, two tenant variants.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5",
    "@types/node": "^20",
    "tsx": "^4.23.0"
  },
  "exports": {
    ".": "./src/app.ts",
    "./*": "./src/*.ts"
  }
}
